# Copy to .env and fill in. .env is gitignored; keep it that way.

# PostgreSQL connection string, used by the server and by drizzle-kit.
# Any Postgres works — a local one, Neon, Supabase, RDS.
DATABASE_URL="postgresql://user:password@localhost:5432/swipe_social"

# Signs the session cookie. The server refuses to start without at least 32
# characters, because a guessable secret means forgeable sessions.
#
#   openssl rand -base64 32
#
# Changing it signs everyone out, which is the right response to a leak.
SESSION_SECRET=""

# Optional. `production` serves the built client from dist/ instead of running
# the Vite dev middleware, and marks the session cookie Secure (HTTPS only).
NODE_ENV=development

# Optional. Defaults to 5000. Managed hosts set this for you.
PORT=5000

# Optional. Only needed when the client is served from a different origin than
# the API — a separate static host, or a custom domain in front of it. A single
# deployment serving both does not need it. Comma-separated.
# PUBLIC_ORIGIN="https://your-app.example.com"

# Optional, client-side. Points the browser at an API on another origin. Leave
# unset and the client calls the same origin it was served from, which is what
# you want in almost every case. Compiled into the bundle at build time.
# VITE_API_BASE_URL="https://api.your-app.example.com"
